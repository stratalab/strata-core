{
  "$defs": {
    "AvailabilityKind": {
      "description": "[`Availability`] without its payload: the one word a caller branches on.\n\nSerializes as the snake_case variant name (`not_downloaded`), which is the\nvalue of `details.availability` on every inference refusal.",
      "oneOf": [
        {
          "const": "ready",
          "description": "[`Availability::Ready`].",
          "type": "string"
        },
        {
          "const": "not_in_catalog",
          "description": "[`Availability::NotInCatalog`].",
          "type": "string"
        },
        {
          "const": "path_missing",
          "description": "[`Availability::PathMissing`].",
          "type": "string"
        },
        {
          "const": "task_not_supported",
          "description": "[`Availability::TaskNotSupported`].",
          "type": "string"
        },
        {
          "const": "local_execution_not_built",
          "description": "[`Availability::LocalExecutionNotBuilt`].",
          "type": "string"
        },
        {
          "const": "provider_not_built",
          "description": "[`Availability::ProviderNotBuilt`].",
          "type": "string"
        },
        {
          "const": "network_disabled",
          "description": "[`Availability::NetworkDisabled`].",
          "type": "string"
        },
        {
          "const": "key_missing",
          "description": "[`Availability::KeyMissing`].",
          "type": "string"
        },
        {
          "const": "not_downloaded",
          "description": "[`Availability::NotDownloaded`].",
          "type": "string"
        }
      ]
    },
    "InferenceCapability": {
      "description": "Provider/model capability facts.",
      "properties": {
        "availability": {
          "$ref": "#/$defs/AvailabilityKind",
          "description": "Whether the model can be used right now, and if not, the one reason\nwhy — the same answer a refusal carries in its `details`, given here\nbefore anything is attempted (#3226). Capability *locates* the model:\na cloud model is `ready` from here even without its key (`status`\nreports keys), and a local model reports `not_downloaded` or\n`not_in_catalog` on the same basis a `pull` or a load would."
        },
        "can_embed": {
          "description": "Whether **this binary** can embed with this model right now.",
          "type": "boolean"
        },
        "can_generate": {
          "description": "Whether **this binary** can generate with this model right now.\n\nFalse when the provider's feature is compiled out, even for a model\nthat inherently generates — see `provider_feature_enabled` for why. The\nmodel's own task is in the catalog (`inference models list`).",
          "type": "boolean"
        },
        "can_rank": {
          "description": "Whether **this binary** can rank with this model right now.",
          "type": "boolean"
        },
        "can_tokenize": {
          "description": "Whether **this binary** can tokenize with this model right now.",
          "type": "boolean"
        },
        "embedding_dim": {
          "description": "Known embedding dimension, if available.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "model": {
          "description": "Model name or path after provider parsing.",
          "type": "string"
        },
        "network_enabled": {
          "description": "Whether this runtime configuration currently allows network access.",
          "type": "boolean"
        },
        "provider": {
          "$ref": "#/$defs/ProviderKind",
          "description": "Provider kind."
        },
        "provider_feature_enabled": {
          "description": "Whether this binary was compiled with the provider feature needed for execution.",
          "type": "boolean"
        },
        "pull_spec": {
          "description": "The spec `strata inference models pull` takes to fetch the model.\nPresent only when `availability` is `not_downloaded`.",
          "type": [
            "string",
            "null"
          ]
        },
        "requires_api_key": {
          "description": "Whether the provider requires an API key.",
          "type": "boolean"
        },
        "requires_network": {
          "description": "Whether the operation requires network access.",
          "type": "boolean"
        },
        "size_bytes": {
          "description": "The download size in bytes. Present only when `availability` is\n`not_downloaded`.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "supports_json_object": {
          "description": "Whether `response_format: json_object` is honored.",
          "type": "boolean"
        },
        "supports_json_schema": {
          "description": "Whether `response_format: json_schema` (structured output) is honored.",
          "type": "boolean"
        },
        "supports_logprobs": {
          "description": "Whether `logprobs` are returned in the response.",
          "type": "boolean"
        },
        "supports_tools": {
          "description": "Whether chat requests may offer `tools` (function calling).",
          "type": "boolean"
        }
      },
      "required": [
        "provider",
        "model",
        "availability",
        "can_generate",
        "can_tokenize",
        "can_embed",
        "can_rank",
        "requires_network",
        "requires_api_key",
        "provider_feature_enabled",
        "network_enabled",
        "embedding_dim",
        "supports_tools",
        "supports_json_object",
        "supports_json_schema",
        "supports_logprobs"
      ],
      "type": "object"
    },
    "ProviderKind": {
      "description": "Which inference provider to use.",
      "oneOf": [
        {
          "const": "local",
          "description": "Local GGUF model provider.",
          "type": "string"
        },
        {
          "const": "anthropic",
          "description": "Anthropic cloud provider.",
          "type": "string"
        },
        {
          "const": "openai",
          "description": "OpenAI cloud provider.",
          "type": "string"
        },
        {
          "const": "google",
          "description": "Google Gemini cloud provider.",
          "type": "string"
        }
      ]
    }
  },
  "$id": "https://stratadb.org/idl/v1/schemas/inference.capability.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "command": "inference.capability",
  "request": {
    "additionalProperties": false,
    "description": "Returns capability facts for one inference model spec.",
    "properties": {
      "model": {
        "description": "Model spec.",
        "type": "string"
      },
      "type": {
        "const": "inference_model_capability",
        "type": "string"
      }
    },
    "required": [
      "type",
      "model"
    ],
    "type": "object"
  },
  "response": {
    "description": "Inference capability facts.",
    "properties": {
      "data": {
        "$ref": "#/$defs/InferenceCapability"
      },
      "type": {
        "const": "inference_capability",
        "type": "string"
      }
    },
    "required": [
      "type",
      "data"
    ],
    "type": "object"
  }
}

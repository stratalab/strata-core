{
  "$defs": {
    "BatchExistsPresence": {
      "description": "Positional batch-existence item: whether the key at this position exists.\njson/vector batch reads are positional (no echoed key), so `batch_exists`\ncarries only the presence bool; callers correlate by the `BatchItem` index.",
      "properties": {
        "exists": {
          "type": "boolean"
        }
      },
      "required": [
        "exists"
      ],
      "type": "object"
    },
    "BatchItem6": {
      "description": "Shared positional item wrapper for all public batch responses.",
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "commit": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommitReceipt"
            },
            {
              "type": "null"
            }
          ]
        },
        "effect": {
          "anyOf": [
            {
              "$ref": "#/$defs/MutationEffect"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "index": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/BatchExistsPresence"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/BatchItemStatus"
        }
      },
      "required": [
        "index",
        "status",
        "applied"
      ],
      "type": "object"
    },
    "BatchItemStatus": {
      "description": "Normalized positional item status within a batch response.",
      "oneOf": [
        {
          "const": "ok",
          "description": "The item was accepted by the command.",
          "type": "string"
        },
        {
          "const": "miss",
          "description": "The item was valid, but the requested record was not found.",
          "type": "string"
        },
        {
          "const": "error",
          "description": "The item failed validation or execution.",
          "type": "string"
        }
      ]
    },
    "BatchMode": {
      "description": "Batch execution semantics.",
      "oneOf": [
        {
          "const": "atomic",
          "description": "The command is one atomic unit. Invalid operations fail the whole\ncommand before item results are returned.",
          "type": "string"
        },
        {
          "const": "itemwise",
          "description": "Valid items are applied together while invalid items are reported in\npositional item results.",
          "type": "string"
        }
      ]
    },
    "BatchResult6": {
      "description": "Shared batch response wrapper for all public batch commands.",
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "commit": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommitReceipt"
            },
            {
              "type": "null"
            }
          ]
        },
        "items": {
          "items": {
            "$ref": "#/$defs/BatchItem6"
          },
          "type": "array"
        },
        "mode": {
          "$ref": "#/$defs/BatchMode"
        },
        "status": {
          "$ref": "#/$defs/BatchStatus"
        }
      },
      "required": [
        "mode",
        "status",
        "applied",
        "items"
      ],
      "type": "object"
    },
    "BatchStatus": {
      "description": "Normalized batch-level outcome status.",
      "oneOf": [
        {
          "const": "ok",
          "description": "The batch completed without item-level errors or mixed apply/no-op\nmutation results.",
          "type": "string"
        },
        {
          "const": "partial",
          "description": "The batch contains a mix of successful and failed, missed, or no-op\nitems.",
          "type": "string"
        },
        {
          "const": "error",
          "description": "Every item failed.",
          "type": "string"
        }
      ]
    },
    "CommitDurability": {
      "description": "Per-commit durability, as storage attested it at acknowledgement time.\n\n`standard` is an admission fact, not a survival guarantee: the commit\nbecomes durable at the next sync point (close, threshold, rotation) and\ncan be lost to process kill until then. Only `always` attests the commit\nwas synced before acknowledgement. `uncertain` means storage could not\nattest either way (#2756: the former `durable` boolean reported\n`standard` commits as durable, so SDK callers treated unsynced\nacknowledgements as crash-safe).",
      "oneOf": [
        {
          "const": "not_durable",
          "description": "Volatile commit (cache mode): gone when the process exits.",
          "type": "string"
        },
        {
          "const": "standard",
          "description": "Durable after the next sync point; lost with the process until then.",
          "type": "string"
        },
        {
          "const": "always",
          "description": "Synced to durable storage before acknowledgement.",
          "type": "string"
        },
        {
          "const": "uncertain",
          "description": "Storage could not attest this commit's durability.",
          "type": "string"
        }
      ]
    },
    "CommitOutcomeStatus": {
      "description": "V1 commit outcome status.",
      "oneOf": [
        {
          "const": "not_applicable",
          "description": "The operation did not attempt a commit.",
          "type": "string"
        },
        {
          "const": "not_started",
          "description": "Validation failed before commit machinery began.",
          "type": "string"
        },
        {
          "const": "definitely_not_committed",
          "description": "Commit machinery began, but no commit became visible or durable.",
          "type": "string"
        },
        {
          "const": "maybe_committed",
          "description": "Strata cannot prove whether the commit became visible or durable.",
          "type": "string"
        },
        {
          "const": "committed_post_commit_failed",
          "description": "The commit succeeded, but a post-commit action failed.",
          "type": "string"
        }
      ]
    },
    "CommitReceipt": {
      "description": "Commit facts returned by mutating operations.",
      "properties": {
        "committed_at": {
          "default": null,
          "description": "The wall-clock instant the commit was applied (UTC epoch microseconds) —\nthe value to format as a calendar date. `null` when unknown (a replayed\nor imported commit). Distinct from the logical `timestamp` (#3112).",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "delete_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "durability": {
          "$ref": "#/$defs/CommitDurability"
        },
        "put_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "timestamp": {
          "description": "Commit's position on the logical commit timeline: a monotonic counter\nassigned per commit, so a fresh database starts small (near 1) and it is\nnever a calendar date. Pass it to `--as-of` and match it against\n`history`; do not format it as a Unix/epoch timestamp. For the real\nwall-clock time, use `committed_at`.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "version": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "timestamp",
        "durability",
        "put_count",
        "delete_count"
      ],
      "type": "object"
    },
    "ErrorClass": {
      "description": "V1 public error class.",
      "oneOf": [
        {
          "const": "not_found",
          "description": "A requested object does not exist.",
          "type": "string"
        },
        {
          "const": "already_exists",
          "description": "A create operation targeted an object that already exists.",
          "type": "string"
        },
        {
          "const": "invalid_argument",
          "description": "Caller supplied malformed input or an invalid option.",
          "type": "string"
        },
        {
          "const": "failed_precondition",
          "description": "Current database state or mode does not allow the operation.",
          "type": "string"
        },
        {
          "const": "access_denied",
          "description": "Caller or backend lacks permission for the operation.",
          "type": "string"
        },
        {
          "const": "conflict",
          "description": "Request conflicts with current state.",
          "type": "string"
        },
        {
          "const": "ambiguous_commit",
          "description": "The system cannot prove whether a write committed.",
          "type": "string"
        },
        {
          "const": "history_unavailable",
          "description": "Requested history is outside the retained window.",
          "type": "string"
        },
        {
          "const": "unsupported",
          "description": "Feature, backend, mode, format, provider, or capability is unsupported.",
          "type": "string"
        },
        {
          "const": "resource_exhausted",
          "description": "A capacity, quota, memory, disk, or configured limit was exceeded.",
          "type": "string"
        },
        {
          "const": "unavailable",
          "description": "Required service, backend, provider, lock, endpoint, or model is unavailable.",
          "type": "string"
        },
        {
          "const": "io",
          "description": "Storage or filesystem IO failed without stronger classification.",
          "type": "string"
        },
        {
          "const": "corruption",
          "description": "Durable state or provider output violates integrity expectations.",
          "type": "string"
        },
        {
          "const": "data_loss",
          "description": "Durable engine state that should exist cannot be reconstructed — a\nstored record failed to decode or a required artifact is gone. Distinct\nfrom `Corruption` (integrity violation detected) in that the data is\nunrecoverable, not merely inconsistent.",
          "type": "string"
        },
        {
          "const": "serialization",
          "description": "Encoding, decoding, schema, format, or protocol conversion failed.",
          "type": "string"
        },
        {
          "const": "internal",
          "description": "Strata hit an invariant failure.",
          "type": "string"
        }
      ]
    },
    "ErrorDetail": {
      "description": "Redacted structured error detail.",
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "type": "object"
    },
    "ErrorStatus": {
      "description": "Public V1 executor error status.",
      "properties": {
        "class": {
          "$ref": "#/$defs/ErrorClass"
        },
        "code": {
          "type": "string"
        },
        "commit_outcome": {
          "$ref": "#/$defs/CommitOutcomeStatus"
        },
        "details": {
          "items": {
            "$ref": "#/$defs/ErrorDetail"
          },
          "type": "array"
        },
        "docs_url": {
          "type": "string"
        },
        "hints": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "message": {
          "type": "string"
        },
        "reference_id": {
          "type": "string"
        },
        "retry_policy": {
          "$ref": "#/$defs/RetryPolicy"
        },
        "retryable": {
          "type": "boolean"
        },
        "suggested_fix": {
          "type": "string"
        },
        "trace_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "class",
        "code",
        "retry_policy",
        "retryable",
        "commit_outcome",
        "message",
        "suggested_fix",
        "docs_url",
        "reference_id"
      ],
      "type": "object"
    },
    "MutationEffect": {
      "description": "Normalized mutation effect facts.",
      "properties": {
        "affected_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "applied": {
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/MutationEffectKind"
        },
        "matched": {
          "type": "boolean"
        }
      },
      "required": [
        "applied",
        "kind",
        "matched",
        "affected_count"
      ],
      "type": "object"
    },
    "MutationEffectKind": {
      "description": "High-level mutation effect for idempotent and conditional operations.",
      "oneOf": [
        {
          "const": "created",
          "description": "A new logical entity was created.",
          "type": "string"
        },
        {
          "const": "updated",
          "description": "An existing logical entity was updated.",
          "type": "string"
        },
        {
          "const": "deleted",
          "description": "An existing logical entity was deleted.",
          "type": "string"
        },
        {
          "const": "unchanged",
          "description": "The operation matched but left state unchanged.",
          "type": "string"
        },
        {
          "const": "not_found",
          "description": "The operation did not match a visible entity.",
          "type": "string"
        }
      ]
    },
    "RetryPolicy": {
      "description": "V1 retry policy.",
      "oneOf": [
        {
          "const": "never",
          "description": "Retrying the same request without changing input or state should not help.",
          "type": "string"
        },
        {
          "const": "after_state_change",
          "description": "Retry may work after configuration, branch, backend, model, or permission changes.",
          "type": "string"
        },
        {
          "const": "same_request",
          "description": "Retrying the exact same request is safe and may succeed.",
          "type": "string"
        },
        {
          "const": "idempotent_only",
          "description": "Retry is safe only for proven-idempotent operations.",
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "Strata cannot safely classify retryability.",
          "type": "string"
        }
      ]
    }
  },
  "$id": "https://stratadb.org/idl/v1/schemas/json.batch_exists.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "command": "json.batch_exists",
  "request": {
    "additionalProperties": false,
    "description": "Batch-checks JSON document existence.\n\n# Guaranteed semantics\n\n- **Positional.** Results are returned in request order, one per key, so\n  a caller can zip them against the keys it sent.\n- **Limits.** Each key bears a document id at most **65,535 bytes**\n  (`invalid_argument.engine.json_document_id`).",
    "properties": {
      "branch": {
        "description": "Target branch. Defaults to the executor handle branch.",
        "type": [
          "string",
          "null"
        ]
      },
      "keys": {
        "description": "Document keys to check.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "space": {
        "description": "Target product space. Defaults to `\"default\"`.",
        "type": [
          "string",
          "null"
        ]
      },
      "type": {
        "const": "json_batch_exists",
        "type": "string"
      }
    },
    "required": [
      "type",
      "keys"
    ],
    "type": "object"
  },
  "response": {
    "description": "JSON batch document-existence results.",
    "properties": {
      "data": {
        "$ref": "#/$defs/BatchResult6"
      },
      "type": {
        "const": "json_batch_exists_results",
        "type": "string"
      }
    },
    "required": [
      "type",
      "data"
    ],
    "type": "object"
  }
}

{
  "$defs": {
    "VectorCollectionInfo": {
      "description": "Vector collection facts.",
      "properties": {
        "count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "dimension": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "embedding_model": {
          "description": "The model that produced this collection's vectors, when recorded (D9).\n\nAbsent for collections created before provenance existed, and for any\ncreated without one. Those accept vectors from any model, so nothing\ncan check that a query is comparable with what is stored.",
          "type": [
            "string",
            "null"
          ]
        },
        "metric": {
          "$ref": "#/$defs/VectorDistanceMetric"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "dimension",
        "metric",
        "count"
      ],
      "type": "object"
    },
    "VectorDistanceMetric": {
      "description": "Vector distance metric exposed through the command boundary.",
      "oneOf": [
        {
          "const": "cosine",
          "description": "Cosine similarity.",
          "type": "string"
        },
        {
          "const": "euclidean",
          "description": "Euclidean similarity.",
          "type": "string"
        },
        {
          "const": "dot_product",
          "description": "Raw dot product.",
          "type": "string"
        }
      ]
    }
  },
  "$id": "https://stratadb.org/idl/v1/schemas/vector.collection.create.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "command": "vector.collection.create",
  "request": {
    "additionalProperties": false,
    "description": "Creates a vector collection.\n\n# Guaranteed semantics\n\n- **Limits.** A collection name is at most **256 bytes**\n  (`invalid_argument.engine.vector_collection`), and the embedding\n  dimension is between 1 and **32,768**\n  (`invalid_argument.engine.vector_dimension`). Each is refused before\n  the collection is created.",
    "properties": {
      "branch": {
        "description": "Target branch. Defaults to the executor handle branch.",
        "type": [
          "string",
          "null"
        ]
      },
      "collection": {
        "description": "Collection name.",
        "type": "string"
      },
      "dimension": {
        "description": "Embedding dimension.",
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "embedding_model": {
        "description": "The model that produces this collection's vectors (D9).\n\nWhat the record governs: `text` on `vector upsert` and\n`vector query` is embedded with this model and no other, so text\nwrites and searches cannot mix models — the failure dimension\ncannot catch, since two models at the same width return neighbours\nthat are ranked and meaningless. What it cannot govern: a `vector`\nsupplied directly carries no model, so Strata cannot check one\nagainst the record; supplying a vector is the caller's statement\nthat this model produced it.",
        "type": [
          "string",
          "null"
        ]
      },
      "metric": {
        "$ref": "#/$defs/VectorDistanceMetric",
        "description": "Distance metric."
      },
      "space": {
        "description": "Target product space. Defaults to `\"default\"`.",
        "type": [
          "string",
          "null"
        ]
      },
      "type": {
        "const": "vector_create_collection",
        "type": "string"
      }
    },
    "required": [
      "type",
      "collection",
      "dimension",
      "metric"
    ],
    "type": "object"
  },
  "response": {
    "description": "Vector collection list.",
    "properties": {
      "data": {
        "description": "Shared pagination continuation facts.",
        "properties": {
          "cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "has_more": {
            "type": "boolean"
          },
          "items": {
            "description": "Collections in this page.",
            "items": {
              "$ref": "#/$defs/VectorCollectionInfo"
            },
            "type": "array"
          }
        },
        "required": [
          "items",
          "has_more"
        ],
        "type": "object"
      },
      "type": {
        "const": "vector_collection_list",
        "type": "string"
      }
    },
    "required": [
      "type",
      "data"
    ],
    "type": "object"
  }
}

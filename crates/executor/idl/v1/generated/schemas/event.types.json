{
  "$id": "https://stratadb.org/idl/v1/schemas/event.types.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "command": "event.types",
  "request": {
    "additionalProperties": false,
    "description": "Lists event types.",
    "properties": {
      "as_of": {
        "description": "Read as of a position on the logical commit timeline — the\n`timestamp` from `history` output, not the `version`, and never a\ncalendar date. To read as of a real time, use `as_of_time` instead.",
        "format": "uint64",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "as_of_time": {
        "description": "Read as of a real time: a wall-clock instant in microseconds since\nthe Unix epoch (UTC), as reported by `committed_at` on a write ack\nor on any `history` row. Resolves to the commit at or before that\ninstant, and fails rather than guessing if the instant falls\noutside the branch's recorded history. Mutually exclusive with\n`as_of`.",
        "format": "uint64",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "branch": {
        "description": "Target branch. Defaults to the executor handle branch.",
        "type": [
          "string",
          "null"
        ]
      },
      "space": {
        "description": "Target product space. Defaults to `\"default\"`.",
        "type": [
          "string",
          "null"
        ]
      },
      "type": {
        "const": "event_list_types",
        "type": "string"
      }
    },
    "required": [
      "type"
    ],
    "type": "object"
  },
  "response": {
    "description": "Event type list.",
    "properties": {
      "data": {
        "description": "Shared pagination continuation facts.",
        "properties": {
          "cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "has_more": {
            "type": "boolean"
          },
          "items": {
            "description": "Event types in this page.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "items",
          "has_more"
        ],
        "type": "object"
      },
      "type": {
        "const": "event_type_list",
        "type": "string"
      }
    },
    "required": [
      "type",
      "data"
    ],
    "type": "object"
  }
}

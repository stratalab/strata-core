{
  "$defs": {
    "CommitDurability": {
      "description": "Per-commit durability, as storage attested it at acknowledgement time.\n\n`standard` is an admission fact, not a survival guarantee: the commit\nbecomes durable at the next sync point (close, threshold, rotation) and\ncan be lost to process kill until then. Only `always` attests the commit\nwas synced before acknowledgement. `uncertain` means storage could not\nattest either way (#2756: the former `durable` boolean reported\n`standard` commits as durable, so SDK callers treated unsynced\nacknowledgements as crash-safe).",
      "oneOf": [
        {
          "const": "not_durable",
          "description": "Volatile commit (cache mode): gone when the process exits.",
          "type": "string"
        },
        {
          "const": "standard",
          "description": "Durable after the next sync point; lost with the process until then.",
          "type": "string"
        },
        {
          "const": "always",
          "description": "Synced to durable storage before acknowledgement.",
          "type": "string"
        },
        {
          "const": "uncertain",
          "description": "Storage could not attest this commit's durability.",
          "type": "string"
        }
      ]
    },
    "CommitReceipt": {
      "description": "Commit facts returned by mutating operations.",
      "properties": {
        "committed_at": {
          "default": null,
          "description": "The wall-clock instant the commit was applied (UTC epoch microseconds) —\nthe value to format as a calendar date. `null` when unknown (a replayed\nor imported commit). Distinct from the logical `timestamp` (#3112).",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "delete_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "durability": {
          "$ref": "#/$defs/CommitDurability"
        },
        "put_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "timestamp": {
          "description": "Commit's position on the logical commit timeline: a monotonic counter\nassigned per commit, so a fresh database starts small (near 1) and it is\nnever a calendar date. Pass it to `--as-of` and match it against\n`history`; do not format it as a Unix/epoch timestamp. For the real\nwall-clock time, use `committed_at`.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "version": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "timestamp",
        "durability",
        "put_count",
        "delete_count"
      ],
      "type": "object"
    },
    "GraphBindingPrimitive": {
      "description": "Product primitive kind used by graph entity bindings.",
      "oneOf": [
        {
          "const": "kv",
          "description": "KV primitive.",
          "type": "string"
        },
        {
          "const": "json",
          "description": "JSON primitive.",
          "type": "string"
        },
        {
          "const": "vector",
          "description": "Vector primitive.",
          "type": "string"
        },
        {
          "const": "event",
          "description": "Event primitive.",
          "type": "string"
        },
        {
          "const": "graph",
          "description": "Graph primitive.",
          "type": "string"
        }
      ]
    },
    "GraphBindingTarget": {
      "description": "Typed product identity attached to a graph node.",
      "properties": {
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "type": "string"
        },
        "primitive": {
          "$ref": "#/$defs/GraphBindingPrimitive"
        },
        "space": {
          "type": "string"
        }
      },
      "required": [
        "primitive",
        "space",
        "key"
      ],
      "type": "object"
    },
    "GraphEntityBinding": {
      "description": "Node-to-entity binding.",
      "properties": {
        "target": {
          "$ref": "#/$defs/GraphBindingTarget"
        }
      },
      "required": [
        "target"
      ],
      "type": "object"
    },
    "MutationEffect": {
      "description": "Normalized mutation effect facts.",
      "properties": {
        "affected_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "applied": {
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/MutationEffectKind"
        },
        "matched": {
          "type": "boolean"
        }
      },
      "required": [
        "applied",
        "kind",
        "matched",
        "affected_count"
      ],
      "type": "object"
    },
    "MutationEffectKind": {
      "description": "High-level mutation effect for idempotent and conditional operations.",
      "oneOf": [
        {
          "const": "created",
          "description": "A new logical entity was created.",
          "type": "string"
        },
        {
          "const": "updated",
          "description": "An existing logical entity was updated.",
          "type": "string"
        },
        {
          "const": "deleted",
          "description": "An existing logical entity was deleted.",
          "type": "string"
        },
        {
          "const": "unchanged",
          "description": "The operation matched but left state unchanged.",
          "type": "string"
        },
        {
          "const": "not_found",
          "description": "The operation did not match a visible entity.",
          "type": "string"
        }
      ]
    }
  },
  "$id": "https://stratadb.org/idl/v1/schemas/graph.node.add.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "command": "graph.node.add",
  "request": {
    "additionalProperties": false,
    "description": "Adds or replaces a graph node.\n\n# Guaranteed semantics\n\n- **Limits.** A node id is at most **1,024 bytes**\n  (`invalid_argument.engine.graph_node_id`), refused before anything is\n  written.",
    "properties": {
      "binding": {
        "anyOf": [
          {
            "$ref": "#/$defs/GraphEntityBinding"
          },
          {
            "type": "null"
          }
        ],
        "description": "Optional entity binding."
      },
      "branch": {
        "description": "Target branch. Defaults to the executor handle branch.",
        "type": [
          "string",
          "null"
        ]
      },
      "graph": {
        "description": "Graph name.",
        "type": "string"
      },
      "node_id": {
        "description": "Node id.",
        "type": "string"
      },
      "object_type": {
        "description": "Optional declared object type (validated once the ontology is frozen).",
        "type": [
          "string",
          "null"
        ]
      },
      "properties": {
        "description": "Optional node properties."
      },
      "space": {
        "description": "Target product space. Defaults to `\"default\"`.",
        "type": [
          "string",
          "null"
        ]
      },
      "type": {
        "const": "graph_add_node",
        "type": "string"
      }
    },
    "required": [
      "type",
      "graph",
      "node_id"
    ],
    "type": "object"
  },
  "response": {
    "description": "Graph node write acknowledgement.",
    "properties": {
      "data": {
        "properties": {
          "commit": {
            "$ref": "#/$defs/CommitReceipt",
            "description": "Commit receipt."
          },
          "effect": {
            "$ref": "#/$defs/MutationEffect",
            "description": "Mutation effect facts."
          },
          "graph": {
            "description": "Graph name.",
            "type": "string"
          },
          "node_id": {
            "description": "Node id.",
            "type": "string"
          }
        },
        "required": [
          "graph",
          "node_id",
          "effect",
          "commit"
        ],
        "type": "object"
      },
      "type": {
        "const": "graph_node_write_result",
        "type": "string"
      }
    },
    "required": [
      "type",
      "data"
    ],
    "type": "object"
  }
}
